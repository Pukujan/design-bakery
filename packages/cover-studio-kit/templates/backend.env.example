# Cover Studio standalone — see packages/cover-studio-kit/README.md
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_OCR_MODEL=qwen/qwen3-vl-8b-instruct
PUBLISH_KIT_VISUAL_MODE=hybrid
PUBLISH_KIT_HERO_CACHE=1
PUBLISH_KIT_HERO_CACHE_MIN_SCORE=0.55
PUBLISH_KIT_HERO_CACHE_MIN_TAGS=2
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=design-bakery
PORT=8787
# Optional admin JWT (omit for public API + your own rate limit)
ADMIN_JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173
