{
  "name": "design-bakery",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/codegraph-sync.mjs --quiet",
    "dev": "node scripts/dev.mjs",
    "dev:verbose": "node scripts/dev.mjs --verbose",
    "dev:web": "pnpm --dir frontend run dev",
    "dev:api": "pnpm --dir backend run dev",
    "dev:stack": "pnpm --dir backend/services run build && concurrently -n vite,api,svc -c cyan,green,yellow \"pnpm --dir frontend run dev\" \"pnpm --dir backend run dev\" \"pnpm --dir backend/services run build:watch\"",
    "env:split": "node scripts/split-env.mjs",
    "dev:functions": "node scripts/dev-functions.mjs",
    "dev:functions:verbose": "node scripts/dev-functions.mjs --verbose",
    "functions:serve": "pnpm run dev:functions",
    "build": "pnpm --dir frontend run build",
    "preview": "pnpm --dir frontend run preview",
    "seed:firestore": "pnpm dlx tsx scripts/archive/seed-portfolios-firestore.ts",
    "migrate:firestore-to-supabase": "pnpm --dir backend/services run build && pnpm dlx tsx scripts/migrations/migrate-firestore-to-supabase.ts",
    "export:deploy-env": "node scripts/export-deploy-env.mjs",
    "codegraph:init": "codegraph init -i",
    "codegraph:sync": "codegraph sync",
    "codegraph:status": "codegraph status",
    "storage:cors": "node scripts/apply-storage-cors.mjs",
    "test:publish-kit-upload": "pnpm --dir backend/services run test:publish-kit-upload",
    "test:publish-kit-upload:emulator": "pnpm --dir backend/services run test:publish-kit-upload:emulator",
    "test:blog-workflow": "pnpm --dir backend/services run test:blog-workflow",
    "test:blog-workflow:live": "pnpm --dir backend/services run test:blog-workflow:live",
    "test:blog-workflow:live:ai": "pnpm --dir backend/services run test:blog-workflow:live:ai",
    "test:blog-workflow:storage": "pnpm --dir backend/services run test:blog-workflow:storage",
    "test:blog-workflow:full": "pnpm --dir backend/services run test:blog-workflow:full",
    "test:blog-workflow:emulator": "pnpm --dir backend/services run test:blog-workflow:emulator"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "firebase-tools": "^15.18.0",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
