{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "types": ["vite/client", "react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/app/*"],
      "@ekagajpatra-case-study/*": ["../extras/Create Presentation Case Study/src/*"],
      "@invest-ai-case-study/*": ["../extras/invest-ai-case-study/src/*"]
    }
  },
  "include": [
    "src",
    "../extras/invest-ai-case-study/src",
    "../extras/Create Presentation Case Study/src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../archive",
    "../extras/design changes to blog details/**"
  ]
}
