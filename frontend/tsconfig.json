{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "types": ["vite/client", "react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/app/*"],
      "@ekagajpatra-case-study/*": ["extras/Create Presentation Case Study/src/*"],
      "@invest-ai-case-study/*": ["extras/invest-ai-case-study/src/*"],
      "@oni-agent-case-study-v3/*": ["extras/oni_agent_interactive_page_svg_darkmode_src/*"],
      "@oni-agent-case-study-v4/*": ["extras/oni_agent_interactive_page_svg_darkmode_v4_src/*"]
    }
  },
  "include": [
    "src",
    "extras/invest-ai-case-study/src",
    "extras/Create Presentation Case Study/src",
    "extras/oni_agent_interactive_page_svg_darkmode_src",
    "extras/oni_agent_interactive_page_svg_darkmode_v4_src"
  ],
  "exclude": ["node_modules", "dist"]
}
