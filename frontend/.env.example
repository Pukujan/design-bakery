# Frontend (Vite / Vercel) — copy to frontend/.env
# Vite only exposes VITE_* to the browser bundle. Do not put API keys here.
# Backend secrets → backend/.env.example → backend/.env

# Required for admin login — Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=auth-system-be464.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=auth-system-be464
VITE_FIREBASE_PROJECT_ID=auth-system-be464
VITE_FIREBASE_STORAGE_BUCKET=auth-system-be464.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=526663371635
# Same Web app config as API key above
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DB_ROOT=
VITE_FIREBASE_ENABLE_CONTENT_SYNC=false
# VITE_DEV_PORT_BASE=5300

VITE_ENABLE_BLOG_AGENTS=true
VITE_ENABLE_BLOG_PUBLISH_KIT=true
# VITE_USE_FUNCTIONS_EMULATOR=true
VITE_BLOG_API_URL=http://localhost:8787
VITE_CONTENT_BACKEND=supabase
# VITE_DEV_WEB_ONLY=true

# Production: VITE_BLOG_API_URL on Vercel — doc/deploy-vercel-railway.md
