VITE_FIREBASE_API_KEY=AIzaSyDIaw7x-JzBatg2ZH_ilMcLnAJkZ3ePe_E
VITE_FIREBASE_AUTH_DOMAIN=auth-system-be464.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=auth-system-be464
VITE_FIREBASE_PROJECT_ID=auth-system-be464
VITE_FIREBASE_STORAGE_BUCKET=auth-system-be464.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=526663371635
VITE_FIREBASE_APP_ID=1:526663371635:web:f53663aac393ca606e5306
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DB_ROOT=
# Optional: push bundled JSON to Realtime DB on load (usually leave off)
VITE_FIREBASE_ENABLE_CONTENT_SYNC=false
# Only if sync is true; defaults in code are 600000 / 300000
# VITE_FIREBASE_SYNC_COOLDOWN_MS=600000
# VITE_FIREBASE_CACHE_TTL_MS=300000
# Dev server: first free port from base (5300 → 5301 → …). Override base if needed.
# VITE_DEV_PORT_BASE=5300
# Blog agents + publish kit (admin). Unset = on in production builds, off in local dev.
# Set explicitly true for local dev; set false on Vercel to hide in production.
VITE_ENABLE_BLOG_AGENTS=true
VITE_ENABLE_BLOG_PUBLISH_KIT=true
# Local only — must be false or unset on Vercel (production uses deployed callables).
VITE_USE_FUNCTIONS_EMULATOR=true
# Callables are proxied via Vite (same origin) — no need to set host/port; emulator stays on :5001

# --- Cloud Functions (local emulator; production: Firebase secrets / console) ---
# Do not prefix with VITE_ — these must not ship to the browser bundle.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Optional comma-separated allowlist; empty = any signed-in admin user
ALLOWED_ADMIN_EMAILS=
# hybrid | template | ai
PUBLISH_KIT_VISUAL_MODE=hybrid
# Set true only to block Storage uploads from the emulator
# PUBLISH_KIT_SKIP_PRODUCTION_STORAGE=true