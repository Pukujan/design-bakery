# Local emulator / deploy (never commit real keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# Optional comma-separated allowlist; empty = any signed-in admin user
ALLOWED_ADMIN_EMAILS=
# Publish kit: hybrid AI hero (default) + text overlay, or template-only SVG
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# hybrid | template | ai — template skips OpenRouter image calls
PUBLISH_KIT_VISUAL_MODE=hybrid
# Publish kit renders PNGs via sharp; uploads to default Storage bucket when configured
