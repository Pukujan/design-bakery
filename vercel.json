{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --dir frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/case-studies/cortex",
      "destination": "/case-studies/cortex/a/index.html"
    },
    {
      "source": "/case-studies/cortex/",
      "destination": "/case-studies/cortex/a/index.html"
    },
    {
      "source": "/case-studies/cortex/a",
      "destination": "/case-studies/cortex/a/index.html"
    },
    {
      "source": "/((?!.*\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
