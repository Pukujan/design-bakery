# The voice call worker's secrets (deploy/vps/docker-compose.yml service `voice`, TASK-DB-0152).
# Copy to deploy/vps/.env.voice on the VPS; deploy.sh deploys the worker once that file exists.

# The copilot stack's LiveKit keys (~/apps/copilot, the `copilot-livekit` container's LIVEKIT_KEYS).
# The API's VOICE_LIVEKIT_KEY / VOICE_LIVEKIT_SECRET in .env.api are the same pair.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Traces to Phoenix through Octo (voice-agent/telemetry.py): the site's own workspace, as in .env.api
# (OCTO_WORKSPACE_ID, OCTO_API_KEY). Leave empty, or set OCTO_TRACES=off, to send none.
OCTO_WORKSPACE=
OCTO_KEY=
