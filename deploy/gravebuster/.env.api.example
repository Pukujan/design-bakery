# Secrets for the design-bakery API container on gravebuster (issue #80).
#
#   cp deploy/gravebuster/.env.api.example deploy/gravebuster/.env.api
#   chmod 600 deploy/gravebuster/.env.api
#   $EDITOR deploy/gravebuster/.env.api          # fill in every value marked REQUIRED
#   docker compose -f deploy/gravebuster/docker-compose.yml up -d --no-deps api
#
# deploy/gravebuster/.env.api is git-ignored and is the ONLY copy of these secrets on
# the host. deploy/gravebuster/.env stays secret-free (public knobs only) and none of
# these ever enter the image. Never commit this file.
#
# The values come from the Railway service's Variables tab today — Railway stays the
# rollback until the Cloudflare Tunnel points at gravebuster, so nothing copies them
# across automatically. Move them here by hand (issue #80).
#
# REQUIRED means: the API still boots without it, but every route that needs it fails
# at request time. There is no startup validation yet — see docs/self-hosting.md §8.

# --- Admin login (REQUIRED) --------------------------------------------------
# ADMIN_JWT_SECRET signs the admin session JWT (HS256) — a long random string:
#   openssl rand -base64 48
# ADMIN_EMAIL is the one primary admin address; ALLOWED_ADMIN_EMAILS adds more.
# Prefer ADMIN_PASSWORD_HASH (bcrypt) in production; ADMIN_PASSWORD is the dev-only
# plain fallback used when no hash is set. Hash with:
#   node backend/scripts/hash-admin-password.mjs '<password>'
ADMIN_JWT_SECRET=
ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=$2b$10$...
# ADMIN_PASSWORD=
# ALLOWED_ADMIN_EMAILS=
# ADMIN_JWT_TTL_SECONDS=28800

# --- OpenRouter (REQUIRED for the publish kit, media OCR and agent posts) ----
# Secret. One line, no quotes: https://openrouter.ai -> Keys.
OPENROUTER_API_KEY=
# Optional model overrides; the defaults below live in the code already.
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# OPENROUTER_OCR_MODEL=qwen/qwen3-vl-8b-instruct

# --- Octo data layer (REQUIRED) ---------------------------------------------
# Durable data (blog posts, CMS documents, media and cover-studio rows, agent
# tokens) lives on Octo's SQL surface. OCTO_WORKSPACE_ID is the workspace UUID and
# OCTO_API_KEY is a SECRET workspace key (octo_live_ws_...; scopes read, write,
# files, delete). No Postgres connection string is held. Both are required for the
# API to read or write anything. See tasks/TASK-DB-0074-octo-data-layer.md.
OCTO_API_BASE=https://octodb.design-bakery.com
OCTO_WORKSPACE_ID=
OCTO_API_KEY=

# --- Supabase (legacy storage cleanup only; skip on a fresh deploy) ----------
# Needed only while rows still hold old Supabase object URLs so their deletes keep
# working. SUPABASE_SERVICE_ROLE_KEY is a SECRET that bypasses RLS — never in the
# frontend or in deploy/gravebuster/.env.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=design-bakery

# --- Public, non-secret knobs ------------------------------------------------
# Browser origins allowed by CORS, comma-separated. Vercel preview hosts are allowed
# in code. PORT is set by the compose service, so it is not needed here.
ALLOWED_ORIGINS=https://www.design-bakery.com,https://design-bakery.com
# Publish-kit render mode: template (default) or openrouter.
PUBLISH_KIT_VISUAL_MODE=template
# ASSET_PUBLIC_BASE_URL=   # legacy /api/public/assets/:fileId proxy origin; usually unset
