# Copy to deploy/gravebuster/.env on gravebuster (git-ignored).
# deploy.sh / rollback.sh source this file.

# Host port the container is published on — 127.0.0.1 only.
# Pick a free port: `ss -ltn | grep ':8085 '`
WEB_HOST_PORT=8085

# Image tag currently deployed. Written by deploy.sh / rollback.sh; leave empty to
# fall back to design-bakery-web:local.
DESIGN_BAKERY_IMAGE=design-bakery-web:local

# Docker network shared with the Cloudflare Tunnel container (docker-compose.edge.yml).
EDGE_NETWORK=study-os_edge

# Repo checkout used by deploy.sh when it is run without arguments.
# DEPLOY_REPO_DIR=/home/yoav/apps/design-bakery

# ---------------------------------------------------------------------------
# Optional build-time config, inlined into the JS bundle by Vite.
# PUBLIC VALUES ONLY — never a service-role key or any backend secret.
# Unset = the blog falls back to the committed blog-data.json snapshot and
# Supabase-direct reads are disabled. See frontend/.env.example.
# ---------------------------------------------------------------------------
# VITE_SITE_URL=https://www.design-bakery.com
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>
# VITE_BLOG_API_URL=https://<railway-service>
# VITE_CONTENT_BACKEND=supabase
# VITE_ENABLE_BLOG_PUBLISH_KIT=true
