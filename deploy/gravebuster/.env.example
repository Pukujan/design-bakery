# Copy to deploy/gravebuster/.env on gravebuster (git-ignored).
# deploy.sh / rollback.sh source this file.

# Host port the container is published on — 127.0.0.1 only.
# Pick a free port: `ss -ltn | grep ':8085 '`
WEB_HOST_PORT=8085

# Image tag currently deployed. Written by deploy.sh / rollback.sh; leave empty to
# fall back to design-bakery-web:local.
DESIGN_BAKERY_IMAGE=design-bakery-web:local

# ---------------------------------------------------------------------------
# API container (issue #80). Its secrets live in deploy/gravebuster/.env.api
# (git-ignored, optional) — never here, this file is only non-secret knobs.
# ---------------------------------------------------------------------------
# Host port the API is published on — 127.0.0.1 only.
API_HOST_PORT=8788
# DESIGN_BAKERY_API_IMAGE=design-bakery-api:local
# The API deploys/rolls back when deploy/gravebuster/.env.api exists, or when
# WITH_API=1 here. Set WITH_API=1 to make it permanent even before the secret file
# lands; --with-api / --no-api override this for a single run.
# WITH_API=1
# Public origin the API puts in canonical URLs and og:image links for link previews
# (backend/src/api/ogPreview.ts). Defaults to https://www.design-bakery.com; only set
# it for a staging hostname. The SPA shell is fetched from the `web` container, so
# the API must run on the same compose network (it does, by default).
# SITE_URL=https://www.design-bakery.com

# Docker network shared with the Cloudflare Tunnel container (docker-compose.edge.yml).
EDGE_NETWORK=study-os_edge
# Once the site is tunnel-fronted, set WITH_EDGE=1 so EVERY deploy/rollback keeps the
# `web` container on the tunnel network. A plain deploy drops that attachment and the
# tunnel 502s. `--with-edge` / `--no-edge` override this for a single run.
# WITH_EDGE=1

# Repo checkout used by deploy.sh when it is run without arguments.
# DEPLOY_REPO_DIR=/home/yoav/apps/design-bakery

# ---------------------------------------------------------------------------
# Optional build-time config, inlined into the JS bundle by Vite.
# PUBLIC VALUES ONLY — never a service-role key or any backend secret.
#
# On gravebuster set VITE_BLOG_API_URL=https://www.design-bakery.com: that origin
# is the site's own, so the SPA reaches Caddy's /api/* proxy same-origin (no CORS),
# and being absolute it also lets the build-time sitemap generator fetch the live
# blog list. Unset = the blog falls back to the committed blog-data.json snapshot
# and the sitemap lists only those posts. These are BUILD args — a redeploy is
# needed, not a restart. See frontend/.env.example.
# ---------------------------------------------------------------------------
# VITE_SITE_URL=https://www.design-bakery.com
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>
# VITE_BLOG_API_URL=https://www.design-bakery.com
# VITE_CONTENT_BACKEND=supabase
# VITE_ENABLE_BLOG_PUBLISH_KIT=true
