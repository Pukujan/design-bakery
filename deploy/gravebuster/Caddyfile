# design-bakery — Caddy config, 1:1 with the rules in vercel.json (TASK-DB-0055).
#
# Runs inside the container on plain HTTP :80 behind the Cloudflare Tunnel; TLS is
# terminated at the Cloudflare edge. `auto_https off` keeps Caddy from trying ACME
# for the tunnel's hostname.
#
# Vercel routing semantics reproduced here (order matters):
#   1. `redirects` are evaluated before the filesystem, in file order.
#   2. `rewrites` are evaluated *after* the filesystem — a request that matches a real
#      file (or a directory with index.html) is served from disk, never rewritten.
#   3. The first matching rewrite wins; `/((?!.*\.html$).*)` is the last-resort SPA
#      fallback and deliberately skips paths ending in .html (those 404).

{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Internal liveness endpoint for the container HEALTHCHECK / deploy.sh.
	# Not part of the Vercel site (see docs/self-hosting.md, "known differences").
	handle /healthz {
		respond "ok" 200
	}

	route {
		# Not in vercel.json: the apex -> www 307 is Vercel *domain* configuration, and
		# the site has always behaved this way (https://design-bakery.com/x -> 307
		# https://www.design-bakery.com/x). Reproduced here so both hostnames can be
		# routed to this container without serving the site twice. Matches the apex
		# only, so staging hostnames and direct 127.0.0.1 checks are unaffected.
		@apex host design-bakery.com
		handle @apex {
			header Location https://www.design-bakery.com{http.request.uri}
			header Content-Type text/plain
			respond <<BODY
			Redirecting...

			BODY 307
		}

		# ------------------------------------------------------------------ /api proxy
		# Same-origin API (owner decision): the browser talks to /api/* on the site's own
		# hostname and Caddy proxies it to the Express container over the compose network.
		# No api subdomain, no DNS record, no CORS. Placed before the filesystem so the
		# SPA fallback never swallows an API path. The prefix is NOT stripped — the
		# backend mounts its routes under /api (backend/src/server.ts).
		#
		# The upstream is the compose service name: `web` and `api` share the project's
		# default network in the base file, and docker-compose.edge.yml keeps `web` on
		# that network while adding the tunnel network, so this resolves in both cases.
		handle /api/* {
			reverse_proxy api:8787
		}

		# ---------------------------------------------------------------- redirects
		# `respond` + an explicit Location instead of `redir`: Vercel answers these with a
		# 15-byte `Redirecting...\n` text/plain body, and `redir` cannot carry a body. The
		# body is a heredoc because the Caddyfile does not expand \n in quoted strings —
		# the blank line before the closing marker is the trailing newline.
		# vercel.json: { source: "/ai-for-good", destination: "/ai-for-good/", permanent: true }
		# Location is relative on purpose: the container only ever sees http://, so an
		# absolute redirect would downgrade the scheme at the Cloudflare edge.
		@aiForGoodExact path /ai-for-good
		handle @aiForGoodExact {
			header Location /ai-for-good/
			header Content-Type text/plain
			respond <<BODY
			Redirecting...

			BODY 308
		}

		# vercel.json: { source: "/studyos", destination: "https://study.design-bakery.com/", permanent: false }
		@studyosExact path /studyos
		handle @studyosExact {
			header Location https://study.design-bakery.com/
			header Content-Type text/plain
			respond <<BODY
			Redirecting...

			BODY 307
		}

		# vercel.json: { source: "/studyos/:path*", destination: "https://study.design-bakery.com/:path*", permanent: false }
		# handle_path strips the /studyos prefix before the redirect runs, and
		# {http.request.uri} is the post-strip value (the plain {uri} placeholder is
		# resolved from the original request URI and would leak the prefix).
		handle_path /studyos/* {
			header Location https://study.design-bakery.com{http.request.uri}
			header Content-Type text/plain
			respond <<BODY
			Redirecting...

			BODY 307
		}

		# ----------------------------------------------------------------- rewrites
		# vercel.json rewrites /ai-for-good/ and /ai-for-good/:path* to the separate
		# ai-for-good Vercel app. Vercel proxies with Host set to the destination.
		handle /ai-for-good/* {
			# reverse_proxy reads the rewritten URL directly, so strip_prefix is enough
			# here (unlike the redirect above, which needs {http.request.uri}).
			uri strip_prefix /ai-for-good
			reverse_proxy https://ai-for-good-livid.vercel.app {
				header_up Host ai-for-good-livid.vercel.app
			}
		}

		# --- filesystem (Vercel checks this before applying the rewrites below) ---
		# Directory requests: /dir and /dir/ both serve /dir/index.html (no trailing-slash
		# redirect — Vercel serves the directory index directly, e.g. /case-studies/cortex).
		@dirIndex file {path}/index.html
		handle @dirIndex {
			rewrite * {path}/index.html
			header Cache-Control "public, max-age=0, must-revalidate"
			file_server
		}

		@dirIndexTrailing file {path}index.html
		handle @dirIndexTrailing {
			rewrite * {path}index.html
			header Cache-Control "public, max-age=0, must-revalidate"
			file_server
		}

		# Any other existing file (hashed assets, images, pdfs, sitemap.xml, ...).
		@exactFile file {path}
		handle @exactFile {
			header Cache-Control "public, max-age=14400, must-revalidate"
			@htmlAsset path *.html
			header @htmlAsset Cache-Control "public, max-age=0, must-revalidate"
			# Go's mime table (what Caddy uses) disagrees with Vercel on four
			# extensions; the values below are what https://www.design-bakery.com
			# actually returns, verified per file across the 132 non-hashed static
			# files in the build (see docs/self-hosting.md §2).
			@xmlAsset path *.xml
			header @xmlAsset Content-Type "application/xml"
			# text/javascript vs application/javascript.
			@jsAsset path *.js *.mjs
			header @jsAsset Content-Type "application/javascript; charset=utf-8"
			# Go sends application/json bare; Vercel appends the charset.
			@jsonAsset path *.json
			header @jsonAsset Content-Type "application/json; charset=utf-8"
			# Go has no entry for .b64 (base64 asset) or .keep (empty placeholder
			# committed under public/) and sends no Content-Type at all for either;
			# Vercel falls back to application/octet-stream.
			@b64Asset path *.b64 *.keep
			header @b64Asset Content-Type "application/octet-stream"
			file_server
		}

		# vercel.json rewrites /case-studies/cortex, /case-studies/cortex/ and
		# /case-studies/cortex/a to the archived cortex build. The first two are already
		# served by the directory index above (public/case-studies/cortex/index.html);
		# /case-studies/cortex/a only exists as .../a/index.html, so the rewrite applies.
		@cortex path /case-studies/cortex /case-studies/cortex/ /case-studies/cortex/a
		handle @cortex {
			rewrite * /case-studies/cortex/a/index.html
			header Cache-Control "public, max-age=0, must-revalidate"
			file_server
		}

		# The IRE dashboard (built from frontend/ire-app into dist/ire by
		# scripts/build-ire-app.mjs). vercel.json rewrites /ire and /ire/ to its
		# index.html; this mirrors that so the two configs stay 1:1. `@dirIndex` above
		# would serve it too, but its `{path}/index.html` join leaves a double slash for
		# a trailing-slash request, so both spellings are stated explicitly. Hashed
		# assets are real files served by `@exactFile` above — this matches only the two
		# directory spellings, never /ire/assets/*.
		@ire path /ire /ire/
		handle @ire {
			rewrite * /ire/index.html
			header Cache-Control "public, max-age=0, must-revalidate"
			file_server
		}

		# The dashboard was served from /ire/app/ before it became the /ire page itself
		# (TASK-DB-0081). vercel.json sends both spellings to /ire/ with a permanent
		# redirect; this mirrors it so old links and any indexed copy land on the
		# canonical path. Inside `route` the written order is the evaluated order, so this
		# sits after the filesystem handlers and before the SPA fallback: a real file under
		# /ire/app/ still wins, and anything else redirects instead of rendering the shell.
		@ireAppLegacy path /ire/app /ire/app/
		redir @ireAppLegacy /ire/ 301

		# Missing .html file: vercel.json's catch-all excludes `*.html`, so these 404
		# instead of falling back to the SPA shell.
		@htmlNotFound path *.html
		handle @htmlNotFound {
			respond "404: NOT_FOUND" 404
		}

		# ------------------------------------------- Open Graph / link previews
		# Blog and case-study URLs need a per-post <title> and og:* tags; the SPA shell
		# has none, so a shared link previewed as the generic homepage. Vercel ran an
		# Edge middleware for this (middleware.ts); on gravebuster the Express `api`
		# container does (backend/src/api/ogPreview.ts), and this block routes it the
		# requests. The matcher is the same set that router handles: blog list/detail,
		# with or without a portfolio prefix, plus every case-study path.
		#
		# Placed after the filesystem handlers and the `.html` 404 above, matching
		# Vercel: a real file or a static case-study directory (study-os, fossil,
		# fluffy-v4, cortex) is already served from disk and never reaches the API, and
		# a missing `.html` has already 404'd. Only SPA-backed paths fall through to
		# here — the ones the SPA fallback below would otherwise serve the generic
		# shell.
		#
		# This matcher and `OG_PREFIX_RE` in backend/src/api/ogPreview.ts must stay in
		# step; `pnpm test:og-routing` fails CI if they drift. Read
		# additionals/guidelines/agent-devlog-og-previews.md before changing either.
		@ogPreview path_regexp ^/(?:endtoend-engineer|legal-workflow-engineer|ai-engineer|forward-deployed-engineer)?/?blogs(?:/\d+)?/?$|^/case-studies/.+
		handle @ogPreview {
			reverse_proxy api:8787
		}

		# vercel.json: { source: "/((?!.*\\.html$).*)", destination: "/index.html" }
		# SPA fallback — every other unmatched path renders the app shell.
		handle {
			rewrite * /index.html
			header Cache-Control "public, max-age=0, must-revalidate"
			file_server
		}
	}

	# The API can be absent or restarting (WITH_API off, a web-only deploy, or a
	# crash-loop), and then the Open Graph block above has no upstream. Those paths
	# rendered the SPA shell before that block existed, so degrade to it instead of
	# 502ing a working page.
	#
	# `handle_errors` keeps the error's status code — right for a real error page, but
	# here the body is a working page and a 502 would make crawlers and browsers treat
	# it as a failure. So the shell is read with the `{file.}` placeholder and sent
	# with an explicit 200. The path is absolute because `{file.}` does not resolve
	# against `root`; it is the same /srv the `root` directive above uses.
	#
	# Scoped by path on purpose: an error under /api/* must stay an error, because the
	# frontend reads JSON there and a silent index.html would be worse than the 502.
	handle_errors {
		@ogShellFallback path_regexp ^/(?:endtoend-engineer|legal-workflow-engineer|ai-engineer|forward-deployed-engineer)?/?blogs(?:/\d+)?/?$|^/case-studies/.+
		handle @ogShellFallback {
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control "public, max-age=0, must-revalidate"
			respond "{file./srv/index.html}" 200
		}
	}
}
