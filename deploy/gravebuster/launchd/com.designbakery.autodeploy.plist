<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Auto-deploy poller for design-bakery on the Mac (TASK-DB-0086).

	macOS has no systemd; this is the launchd counterpart of
	deploy/gravebuster/systemd/design-bakery-autodeploy.{service,timer}, which runs
	the same autodeploy.sh on gravebuster. Modeled on the box's existing
	com.octo.autodeploy agent (same StartInterval, log location, PATH).

	Install (see docs/self-hosting.md §6):
		cp deploy/gravebuster/launchd/com.designbakery.autodeploy.plist \
			~/Library/LaunchAgents/
		launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.designbakery.autodeploy.plist
		launchctl kickstart gui/$(id -u)/com.designbakery.autodeploy   # run once now

	All deploy safety lives in autodeploy.sh -> deploy.sh (lock, smoke, rollback).
-->
<plist version="1.0">
<dict>
	<key>Label</key><string>com.designbakery.autodeploy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/teresaguajardo/apps/design-bakery/deploy/gravebuster/autodeploy.sh</string>
	</array>
	<key>WorkingDirectory</key><string>/Users/teresaguajardo/apps/design-bakery</string>
	<key>EnvironmentVariables</key>
	<dict><key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
	<key>StartInterval</key><integer>300</integer>
	<key>RunAtLoad</key><true/>
	<key>StandardOutPath</key><string>/Users/teresaguajardo/Library/Logs/design-bakery-autodeploy.log</string>
	<key>StandardErrorPath</key><string>/Users/teresaguajardo/Library/Logs/design-bakery-autodeploy.log</string>
</dict>
</plist>
