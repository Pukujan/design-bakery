# Backend (Express / Railway) — copy to backend/.env
# Never commit backend/.env. Do not prefix secrets with VITE_.

# Must be ONE line: OPENROUTER_API_KEY=sk-or-...
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Vision OCR for admin Media Library filename agent (Qwen3-VL 8B)
OPENROUTER_OCR_MODEL=qwen/qwen3-vl-8b-instruct

# ---------------------------------------------------------------------------
# Data layer — Octo (TASK-DB-0074)
# Durable data (blog posts, CMS documents, media + cover-studio rows, agent tokens)
# lives in the Octo-provisioned workspace database and is reached through Octo's SQL
# surface. No Postgres connection string is held: Octo returns one only at provision
# time and has no reveal route. See Octo's docs/consuming-octo.md.
# ---------------------------------------------------------------------------
OCTO_API_BASE=https://octodb.design-bakery.com
OCTO_WORKSPACE_ID=                     # design-bakery workspace UUID
OCTO_API_KEY=                          # workspace key (octo_live_ws_...), write scope

# Supabase — blog/cover image STORAGE only, for now. The tables above no longer come
# from here; the bucket is still read for existing media URLs. Migrating storage onto
# Octo's file API is the remaining piece of TASK-DB-0074.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=design-bakery
IMAGE_STORAGE=supabase
CONTENT_BACKEND=supabase

# Backend admin login (required for API routes)
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=your-dev-password
# ADMIN_PASSWORD_HASH=$2b$10$...  # production: node scripts/hash-admin-password.mjs 'password'
# ADMIN_JWT_TTL_SECONDS=28800

# Comma-separated browser origins (Vercel *.vercel.app previews are allowed automatically in code)
# ALLOWED_ORIGINS=https://www.design-bakery.com,https://design-bakery.com
ALLOWED_ADMIN_EMAILS=
PUBLISH_KIT_VISUAL_MODE=template
# PUBLISH_KIT_FONT_DEBUG=1
# PUBLISH_KIT_FONT_LOG=0
# PORT=8787
