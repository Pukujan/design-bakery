# Backend (Express / Functions emulator / Railway) — copy to backend/.env
# Never commit backend/.env. Do not prefix secrets with VITE_.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Firebase Admin (Storage uploads). Same bucket as VITE_FIREBASE_STORAGE_BUCKET in frontend/.env.
FIREBASE_STORAGE_BUCKET=auth-system-be464.firebasestorage.app
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ALLOWED_ORIGINS=https://www.design-bakery.com,https://design-bakery.com
ALLOWED_ADMIN_EMAILS=
PUBLISH_KIT_VISUAL_MODE=hybrid
# PUBLISH_KIT_SKIP_PRODUCTION_STORAGE=true
# PORT=8787
