{
  "name": "booking: a misheard name and a wrong email are corrected in any form",
  "startPage": {
    "path": "/",
    "title": "Home"
  },
  "steps": [
    {
      "say": "I want to book a consultation.",
      "expect": {
        "navigatesTo": "/contact",
        "textMatch": "name",
        "noActions": [
          "book"
        ]
      }
    },
    {
      "say": "Fo John.",
      "expect": {
        "noActions": [
          "book"
        ],
        "asksToConfirm": true
      }
    },
    {
      "say": "No.",
      "expect": {
        "noActions": [
          "book"
        ],
        "textMatch": "spell"
      }
    },
    {
      "say": "P U J A N.",
      "expect": {
        "noActions": [
          "book"
        ],
        "spells": [
          "pujan"
        ],
        "asksToConfirm": true
      }
    },
    {
      "say": "Yes it is.",
      "expect": {
        "noActions": [
          "book"
        ],
        "textMatch": "How do you say your name"
      }
    },
    {
      "say": "It's fine as spelled.",
      "expect": {
        "noActions": [
          "book"
        ],
        "textMatch": "Thanks, Pujan"
      }
    },
    {
      "say": "poojan three six four five at gmail dot com",
      "expect": {
        "noActions": [
          "book"
        ],
        "spells": [
          "poojan3645"
        ],
        "asksToConfirm": true
      }
    },
    {
      "say": "No, that's wrong. It's P U J A N three six four five at gmail dot com.",
      "expect": {
        "noActions": [
          "book"
        ],
        "spells": [
          "pujan3645"
        ],
        "asksToConfirm": true
      }
    },
    {
      "say": "Yes, product design.",
      "expect": {
        "actions": [
          "book"
        ],
        "maxActions": {
          "book": 1
        },
        "book": {
          "name": "Pujan",
          "email": "pujan3645@gmail.com",
          "topic": "Product design"
        }
      }
    }
  ]
}